{
  "name": "silentwire",
  "version": "0.1.0",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "vite",
    "dependency-injection",
    "di",
    "compile-time",
    "typescript",
    "async",
    "container",
    "scopes"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivlev-dev/silentwire.git"
  },
  "homepage": "https://github.com/ivlev-dev/silentwire",
  "bugs": {
    "url": "https://github.com/ivlev-dev/silentwire/issues"
  },
  "description": "Decorator-free compile-time dependency injection wired from TypeScript types for Vite",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./vite": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    }
  },
  "scripts": {
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true});\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:watch": "vitest",
    "bench": "vitest bench",
    "audit": "pnpm audit",
    "dev:example": "vite --config examples/app/vite.config.ts"
  },
  "peerDependencies": {
    "vite": ">=8"
  },
  "dependencies": {
    "@babel/parser": "^8.0.0",
    "@babel/traverse": "^8.0.0",
    "@babel/types": "^8.0.0",
    "magic-string": "^1.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
